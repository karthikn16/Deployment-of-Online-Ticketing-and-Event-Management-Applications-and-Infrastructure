pipeline {
    agent any

    tools {
        jdk 'jdk17'
        nodejs 'node23'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        IMAGE_NAME   = "karthikn16/bms"
        IMAGE_TAG    = "latest"
        CONTAINER_NAME = "bms"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/karthikn16/Deployment-of-Online-Ticketing-and-Event-Management-Applications-and-Infrastructure.git'

                sh 'ls -la'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectName=BMS \
                        -Dsonar.projectKey=BMS
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'Sonar-token'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    cd bookmyshow-app
                    ls -la

                    if [ -f package.json ]; then
                        rm -rf node_modules package-lock.json
                        npm install
                    else
                        echo "Error: package.json not found!"
                        exit 1
                    fi
                '''
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                echo "Running OWASP Dependency Check..."

                dependencyCheck additionalArguments: '''
                    --scan ./ 
                    --disableYarnAudit 
                    --disableNodeAudit 
                    --noupdate
                ''', odcInstallation: 'DP-Check'

                dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "Running Trivy FileSystem Scan..."
                    trivy fs . --scanners vuln --format table > trivyfs.txt
                    echo "Trivy FS Scan Completed!"
                '''
            }
        }

        stage('Remove Old Docker Images') {
            steps {
                sh '''
                    echo "Removing old Docker images if exist..."

                    docker images | grep "${IMAGE_NAME}" || true

                    docker rmi -f ${IMAGE_NAME}:${IMAGE_TAG} || true

                    docker image prune -f || true

                    echo "Old Docker image cleanup completed!"
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker') {
                        sh '''
                            echo "Checking Docker Version..."
                            docker version

                            echo "Building Docker Image..."
                            docker build --no-cache -t ${IMAGE_NAME}:${IMAGE_TAG} -f bookmyshow-app/Dockerfile bookmyshow-app

                            echo "Pushing Docker Image..."
                            docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        '''
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    echo "Running Trivy Image Scan..."
                    trivy image ${IMAGE_NAME}:${IMAGE_TAG} --scanners vuln --format table > trivyimage.txt
                    echo "Trivy Image Scan Completed!"
                '''
            }
        }

        stage('Deploy to Container') {
            steps {
                sh '''
                    echo "Stopping old container..."
                    docker stop ${CONTAINER_NAME} || true

                    echo "Removing old container..."
                    docker rm ${CONTAINER_NAME} || true

                    echo "Starting new container..."
                    docker run -d --restart=always --name ${CONTAINER_NAME} -p 3000:3000 ${IMAGE_NAME}:${IMAGE_TAG}

                    echo "Checking running containers..."
                    docker ps -a

                    echo "Fetching logs..."
                    sleep 5
                    docker logs ${CONTAINER_NAME}
                '''
            }
        }
    }

    post {
        always {
            emailext attachLog: true,
                subject: "Build Status: ${currentBuild.result}",
                body: """
                    Project: ${env.JOB_NAME}<br/>
                    Build Number: ${env.BUILD_NUMBER}<br/>
                    URL: ${env.BUILD_URL}<br/>
                    Status: ${currentBuild.result}<br/>
                """,
                to: 'karthikeyanak16@gmail.com',
                attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
        }
    }
}
